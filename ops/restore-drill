#!/usr/bin/env bash
# Isolated verification only: never connects to compose or to the live database.
set -euo pipefail
umask 077
: "${BACKUP_KEY:?Set private key PEM path}" "${BACKUP_CERT:?Set certificate PEM path}"
archive=${1:?Pass a trusted encrypted archive}; [[ -s $archive ]] || exit 2
# The entrypoint initializes an isolated empty database on an anonymous volume.
id=$(docker run -d --network none -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=drill postgres:17-alpine)
trap 'docker rm -fv "$id" >/dev/null' EXIT
ready=false
for ((n=0;n<60;n++)); do
 if docker exec "$id" pg_isready -h 127.0.0.1 -U postgres -d drill >/dev/null 2>&1; then ready=true; break; fi
 sleep 1
done
[[ $ready = true ]] || { echo 'Isolated database did not start.' >&2; exit 1; }
openssl cms -decrypt -binary -inform DER -in "$archive" -recip "$BACKUP_CERT" -inkey "$BACKUP_KEY" |
 docker exec -i "$id" pg_restore -U postgres -d drill --single-transaction --exit-on-error --no-owner --no-privileges
# Validate critical tables without emitting client records. A wrong schema fails the drill.
docker exec "$id" psql -X -v ON_ERROR_STOP=1 -U postgres -d drill -c 'SELECT (SELECT count(*) FROM migrations), (SELECT count(*) FROM booking_quotes), (SELECT count(*) FROM gateway_payments), (SELECT count(*) FROM refund_receipts), (SELECT count(*) FROM staff_accounts);' >/dev/null
printf '%s\n' 'Isolated restore and schema checks passed.'
